#!/bin/bash
# Select an area of the screen and copy the text in it to the clipboard.
# Installed by install-capture-text.sh. Timings go to ~/Library/Logs/capture-text.log.
set -euo pipefail

ocr="$HOME/.local/bin/capture-text-ocr"
log_file="$HOME/Library/Logs/capture-text.log"
img=$(mktemp -t capture-text).png
trap 'rm -f "$img"' EXIT

# Epoch seconds with milliseconds, via perl because BSD date has no %N.
stamp() { /usr/bin/perl -MTime::HiRes=time -e 'printf "%.3f", time'; }
log() { printf '%s %s\n' "$(stamp)" "$*" >> "$log_file"; }

log "start"
/usr/sbin/screencapture -i -x "$img" || { log "cancelled"; exit 0; }
[ -s "$img" ] || { log "cancelled (empty image)"; exit 0; }
log "selected size=$(wc -c < "$img" | tr -d ' ') bytes"

text=$("$ocr" "$img" 2>>"$log_file")
log "ocr done chars=${#text}"

if [ -n "$text" ]; then
  printf '%s\n' "$text" | pbcopy
fi
log "copied"
